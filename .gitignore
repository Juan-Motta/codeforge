# OS / editor cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# Transient workflow state — the per-workflow checklist is local working state. Lives under
# .codeforge/ since the consolidation; the rest of .codeforge/ (rules, scripts) IS committed, so
# this must stay path-specific — a bare `.codeforge/` here would untrack the framework itself.
.codeforge/workflow/

# Node dev tooling (tools/) is dependency-free, but guard against stray installs.
node_modules/

# Engine artifacts — generated/dev only, never part of the repo. Created if an agent works
# on codeforge, or if src/sync.sh is run (dogfooding). Regenerated on demand; not shipped.
.claude/
.agents/
.codex/
src/AGENTS.md
src/opencode.json
